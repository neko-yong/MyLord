DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DB"

LLM_ENDPOINT = "https://your-provider.example/v1/chat/completions"
LLM_MODEL = "your-model"
LLM_API_KEY = "YOUR_API_KEY"

ADMIN_CREATE_SECRET = "YOUR_ADMIN_CREATE_SECRET"
ADMIN_CONSOLE_ROUTE_KEY = "YOUR_UNGUESSABLE_ROUTE_KEY"
ADMIN_MAINTENANCE_SECRET = "YOUR_MAINTENANCE_SECRET"

# Optional. Keep false in public deployments.
DEVELOPMENT_MODE = false

# Developer Playground. Effective only when DEV_MODE=true.
# Never enable DEV_MODE in a public production deployment.
DEV_MODE = false
DEV_DATABASE_MODE = "local"
LLM_MODE = "mock"
